generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  clerkId          String    @unique
  email            String    @unique
  name             String
  slug             String    @unique
  profilePhoto     String?
  resumeUrl        String?
  selectedTemplate String    @default("minimal")
  rawText          String?
  profileData      Json?
  isPublic         Boolean   @default(false)
  profileViews     Int       @default(0)
  lastViewedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscription       Subscription?
  tailoredResumes    TailoredResume[]
  settings           UserSettings?
  endorsementsMade   Endorsement[]    @relation("EndorsementAuthor")
  endorsementsRcvd   Endorsement[]    @relation("EndorsementRecipient")
  commentsMade       Comment[]        @relation("CommentAuthor")
  commentsRcvd       Comment[]        @relation("CommentRecipient")
  mediaAssets        MediaAsset[]
  activities         CareerActivity[]

  @@index([slug])
  @@index([clerkId])
}

model Endorsement {
  id          String   @id @default(cuid())
  authorId    String
  recipientId String
  skill       String
  message     String?
  experienceCompany String?
  createdAt   DateTime @default(now())

  author    User @relation("EndorsementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipient User @relation("EndorsementRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([authorId])
  @@unique([authorId, recipientId, skill])
}

model Comment {
  id          String   @id @default(cuid())
  authorId    String
  recipientId String
  experienceCompany String?
  body        String
  approved    Boolean  @default(true)
  createdAt   DateTime @default(now())

  author    User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipient User @relation("CommentRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  userId       String
  url          String
  kind         String   // "event", "award", "fundraiser", "promotion", "other"
  caption      String?
  experienceCompany String?
  year         String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kind])
}

model CareerActivity {
  id          String   @id @default(cuid())
  userId      String
  kind        String   // "promotion", "review", "award", "project", "certification", "custom"
  title       String
  description String?
  date        DateTime
  experienceCompany String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  planId               String    @default("free")
  status               String    @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  startedAt            DateTime  @default(now())
  cancelledAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TailoredResume {
  id          String   @id @default(cuid())
  userId      String
  jobTitle    String
  company     String
  jobUrl      String?
  profileData Json
  matchScore  Float?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id                 String  @id @default(cuid())
  userId             String  @unique
  emailNotifications Boolean @default(true)
  profileVisible     Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
